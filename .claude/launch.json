{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app/backend",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app/frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-celu",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app/frontend",
        "run",
        "dev",
        "--",
        "-H",
        "0.0.0.0"
      ],
      "port": 3000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app/frontend",
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "maquetas",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4100",
        "--directory",
        "docs/maquetas"
      ],
      "port": 4100
    }
  ]
}